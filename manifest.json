{
  "manifest_version": 3,
  "name": "DyslexAid: Reading Assistant",
  "description": "Make any page easier to read: friendly fonts, comfy spacing, bionic reading, a reading ruler, warm tint, and calm mode.",
  "version": "1.4.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle the reading ruler"
    },
    "toggle-bionic": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Toggle bionic reading"
    },
    "read-aloud": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Read aloud (selection or article)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
